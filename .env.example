# Chiave API Claude (https://platform.claude.com) – obbligatoria per gli agenti
ANTHROPIC_API_KEY=

# Modello usato dagli agenti (default: claude-opus-5-5)
# TL_MODEL=claude-opus-5-5

PORT=3000
NODE_ENV=production
# DATABASE_PATH=data/tl.db

# WhatsApp Business Cloud API (Meta)
# Token scelto da te, da inserire anche nella configurazione del webhook su Meta for Developers
WHATSAPP_VERIFY_TOKEN=
# "App secret" dell'app Meta: verifica la firma dei webhook (consigliato)
WHATSAPP_APP_SECRET=
# Token di accesso di default (ogni attività può avere il suo nelle Impostazioni)
WHATSAPP_TOKEN=

# 1 = ogni mattina alle 8 gli agenti preparano le proposte del giorno per ogni attività
AUTO_PROPOSALS=0
